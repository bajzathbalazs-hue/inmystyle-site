var NEW_CATS = [["Ünnepi kollekció", "unnepi-kollekcio"], ["Limitált darabok", "limitalt-darabok"]];

function importNovember() {
  var ss = book(), sh = productSheet();
  var keep = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 16).getValues() : [];
  var backup = ss.getSheetByName("Termékek – mentés") || ss.insertSheet("Termékek – mentés");
  backup.clear(); backup.getRange(1, 1, 1, 16).setValues([sh.getRange(1, 1, 1, 16).getValues()[0]]);
  if (keep.length) backup.getRange(2, 1, keep.length, 16).setValues(keep);
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 16).clearContent();
  var vals = IMPORT_ROWS.map(function (r) { var x = r.slice(); x[1] = ""; return x; });
  sh.getRange(2, 1, vals.length, 16).setValues(vals);
  sh.getRange(2, COL.show, vals.length, 1).insertCheckboxes();
  sh.getRange(2, COL.featured, vals.length, 2).insertCheckboxes();
  setup();
  var cs = ss.getSheetByName("Kategóriák"), have = cs.getDataRange().getValues().map(function (r) { return String(r[0]).trim(); });
  NEW_CATS.forEach(function (c) { if (have.indexOf(c[0]) < 0) cs.appendRow(c); });
  var g = guestSheet();
  if (g.getLastRow() > 1) g.getRange(2, 1, g.getLastRow() - 1, 3).clearContent();
  g.getRange(2, 1, IMPORT_GUESTS.length, 3).setValues(IMPORT_GUESTS);
  g.getRange(2, 1, 200, 1).insertCheckboxes();
  g.getRange(2, 4, 200, 1).setFormula('=IF(B2="";"";IF(LEFT(B2;6)="drive:";IMAGE("https://drive.google.com/thumbnail?sz=w300&id="&MID(B2;7;200));IMAGE("' + RAW + '"&B2)))');
  g.setColumnWidth(2, 260); g.setColumnWidth(3, 320); g.setColumnWidth(4, 110); g.setRowHeights(2, IMPORT_GUESTS.length, 120);
  logEvent("Termékadatlap (2026. nov.) betöltve: " + vals.length + " sor, " + IMPORT_GUESTS.length + " vendégfotó");
  Logger.log("Kész: " + vals.length + " termék, " + IMPORT_GUESTS.length + " vendégfotó.");
}
